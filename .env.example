# Stock_RNN 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ==================== Flask 配置 ====================
SECRET_KEY=your-secret-key-change-in-production
DEBUG=False

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password
DB_NAME=quanttradingsystem

# 可选：直接设置完整的数据库连接字符串
# DATABASE_URL=mysql+pymysql://user:password@host:port/database?charset=utf8mb4

# ==================== 东方财富配置 ====================
# Cookie 用于访问东方财富 API
EASTMONEY_COOKIE=qgqp_b_id=your-cookie-id

# 基金数据 Cookie（更复杂，包含多个字段）
EASTMONEY_FUNDS_COOKIE=em_hq_fls=js; qgqp_b_id=your-cookie-id; your-other-cookies

# ==================== 雪球配置 ====================
# 雪球完整 Cookie 字符串
XUEQIU_COOKIES=device_id=your-device-id; xq_a_token=your-token; xq_id_token=your-jwt-token

# ==================== 下载配置（可选） ====================
SELENIUM_HEADLESS=True
USE_SELENIUM_FALLBACK=True
MAX_RETRIES=3
RETRY_DELAY=5
REQUEST_TIMEOUT=30

# ==================== SQLAlchemy 配置（可选） ====================
SQLALCHEMY_ECHO=False

# ==================== 推送通知（可选，App/services/notifier.py） ====================
# 「底部放量」等信号命中时向所有已配置渠道推送；不配的渠道自动跳过（no-op）。
# 可同时配多个渠道。

# --- 渠道1：WhatsApp（CallMeBot，个人自用最简单，免费） ---
# 激活步骤：手机 WhatsApp 把 +34 644 56 55 18 加为联系人，
#   发送 "I allow callmebot to send me messages"，回信里会带你的 apikey。
CALLMEBOT_PHONE=+8613800138000
CALLMEBOT_APIKEY=your-callmebot-apikey

# --- 渠道2：邮件 SMTP ---
# HOST/USER/PASS 三者齐全才启用；QQ/163 等邮箱 PASS 用「授权码」而非登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@qq.com
SMTP_PASS=your-smtp-auth-code
# 收件人，逗号分隔多个；缺省=SMTP_USER 自己
SMTP_TO=your@qq.com

# --- 渠道3：Server酱 Turbo ---
SERVERCHAN_SENDKEY=SCTxxxxxxxx

# --- 渠道4：企业微信群机器人 ---
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
